{
  "name": "playwrightsetup",
  "version": "1.0.0",
  "description": "Playwright browser tests",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "bdd:generate": "bddgen test",
    "bdd:test": "bddgen test && playwright test --project=orangehrm-bdd",
    "bdd:headed": "bddgen test && playwright test --project=orangehrm-bdd --headed",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2"
  }
}
