{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true
  }
  ,
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"]
}
